const state = {
  currentView: 'inicio',
  filter: 'all',
  notes: JSON.parse(localStorage.getItem('rioNotes') || '[]'),
  reports: JSON.parse(localStorage.getItem('rioReports') || '[]'),
  selectedTemplateId: appData.reportTemplates[0].id
};

const typeColors = { F: 'tag-F', NF: 'tag-NF', SP: 'tag-SP' };

function getViewEls() {
  return {
    navButtons: [...document.querySelectorAll('.nav-btn')],
    filterButtons: [...document.querySelectorAll('.filter-btn')],
    views: [...document.querySelectorAll('.view')],
    dashboardMetrics: document.getElementById('dashboardMetrics'),
    operationalChecklist: document.getElementById('operationalChecklist'),
    objectiveText: document.getElementById('objectiveText'),
    specificObjectives: document.getElementById('specificObjectives'),
    principlesList: document.getElementById('principlesList'),
    requirementsContainer: document.getElementById('requirementsContainer'),
    peiContent: document.getElementById('peiContent'),
    convivenciaContent: document.getElementById('convivenciaContent'),
    academicContent: document.getElementById('academicContent'),
    cumplimientoContent: document.getElementById('cumplimientoContent'),
    mejoramientoContent: document.getElementById('mejoramientoContent'),
    traceabilityChain: document.getElementById('traceabilityChain'),
    trailPills: document.getElementById('trailPills'),
    traceExample: document.getElementById('traceExample'),
    indicatorsBody: document.getElementById('indicatorsBody'),
    searchInput: document.getElementById('searchInput'),
    searchResults: document.getElementById('searchResults'),
    assistantInput: document.getElementById('assistantInput'),
    assistantOutput: document.getElementById('assistantOutput'),
    notesList: document.getElementById('notesList'),
    noteTitle: document.getElementById('noteTitle'),
    noteCategory: document.getElementById('noteCategory'),
    noteInput: document.getElementById('noteInput'),
    networkLabel: document.getElementById('networkLabel'),
    lastSyncLabel: document.getElementById('lastSyncLabel'),
    reportTemplateSelect: document.getElementById('reportTemplateSelect'),
    reportTemplates: document.getElementById('reportTemplates'),
    reportContextInput: document.getElementById('reportContextInput'),
    generatedReports: document.getElementById('generatedReports'),
    pendingReports: document.getElementById('pendingReports')
  };
}

function setView(viewName) {
  state.currentView = viewName;
  const els = getViewEls();

  els.views.forEach((view) => {
    view.classList.toggle('active', view.id === `view-${viewName}`);
  });

  els.navButtons.forEach((btn) => {
    btn.classList.toggle('active', btn.dataset.view === viewName);
  });
}

function renderDashboardMetrics() {
  const els = getViewEls();
  els.dashboardMetrics.innerHTML = appData.metrics.map((metric) => `
    <div class="metric">
      <strong>${metric.value}</strong>
      <span>${metric.label}</span>
    </div>
  `).join('');
}

function renderOperationalChecklist() {
  const els = getViewEls();
  els.operationalChecklist.innerHTML = appData.operationalChecklist.map((item) => `
    <div class="check-item">
      <span class="check-dot">✓</span>
      <span>${item}</span>
    </div>
  `).join('');
}

function renderOverview() {
  const els = getViewEls();
  els.objectiveText.textContent = appData.objective;
  els.specificObjectives.innerHTML = appData.specifics.map((item) => `<li>${item}</li>`).join('');
  els.principlesList.innerHTML = appData.principles.map((item) => `<li>${item}</li>`).join('');
}

function renderRequirements() {
  const els = getViewEls();
  const items = state.filter === 'all'
    ? appData.requirements
    : appData.requirements.filter((item) => item.type === state.filter);

  els.requirementsContainer.innerHTML = items.map((item) => `
    <div class="requirement-card">
      <div class="req-header">
        <span class="req-id">${item.id}</span>
        <span class="req-tag ${typeColors[item.type]}">${item.type}</span>
      </div>
      <p>${item.description}</p>
    </div>
  `).join('');
}

function renderKnowledgeSection(container, items) {
  container.innerHTML = items.map((item) => `
    <div class="info-card">
      <h3>${item.title}</h3>
      <p>${item.summary}</p>
      <ul>
        ${item.bullets.map((bullet) => `<li>${bullet}</li>`).join('')}
      </ul>
    </div>
  `).join('');
}

function renderInstitutionalContent() {
  const els = getViewEls();
  renderKnowledgeSection(els.peiContent, appData.institutional.pei);
  renderKnowledgeSection(els.convivenciaContent, appData.institutional.convivencia);
  renderKnowledgeSection(els.academicContent, appData.institutional.academic);
  renderKnowledgeSection(els.cumplimientoContent, appData.institutional.compliance);
  renderKnowledgeSection(els.mejoramientoContent, appData.institutional.improvement);
}

function renderTraceability() {
  const els = getViewEls();
  els.traceabilityChain.textContent = `Cadena bidireccional: ${appData.traceability.chain} · retorno: ${appData.traceability.returnChain}`;
  els.trailPills.innerHTML = ['C', 'N', 'R', 'S', 'F', 'A', 'I', 'E'].map((item) => `<span>${item}</span>`).join('');
  els.traceExample.innerHTML = appData.traceability.example.map((item) => `
    <div class="trace-item">
      <strong>${item.label}</strong>
      <div>${item.text}</div>
    </div>
  `).join('');
  els.indicatorsBody.innerHTML = appData.traceability.indicators.map((ind) => `
    <tr>
      <td>${ind.name}</td>
      <td>${ind.formula}</td>
      <td>${ind.target}</td>
    </tr>
  `).join('');
}

function renderSearchResults(query) {
  const els = getViewEls();
  const q = (query || '').trim().toLowerCase();

  if (!q) {
    els.searchResults.innerHTML = '<div class="result-card">Escribe una palabra clave para buscar requisitos, normas, dudas, PEI o informes.</div>';
    return;
  }

  const matched = [
    ...appData.requirements.map((req) => ({
      type: 'Requisito',
      title: req.id,
      description: req.description,
      text: `${req.id} ${req.description}`
    })),
    ...appData.procedures.map((proc) => ({
      type: 'Procedimiento',
      title: proc.title,
      description: proc.description,
      text: `${proc.title} ${proc.description} ${proc.area} ${proc.action}`
    })),
    ...appData.traceability.example.map((item) => ({
      type: 'Trazabilidad',
      title: item.label,
      description: item.text,
      text: `${item.label} ${item.text}`
    })),
    ...appData.institutional.pei.flatMap((block) => block.bullets.map((bullet) => ({
      type: 'PEI',
      title: block.title,
      description: bullet,
      text: `${block.title} ${bullet}`
    }))),
    ...appData.institutional.convivencia.flatMap((block) => block.bullets.map((bullet) => ({
      type: 'Convivencia',
      title: block.title,
      description: bullet,
      text: `${block.title} ${bullet}`
    }))),
    ...appData.reportTemplates.flatMap((template) => template.sections.map((section) => ({
      type: 'Informe',
      title: `${template.title}: ${section.title}`,
      description: section.content,
      text: `${template.title} ${section.title} ${section.content}`
    })))
  ].filter((entry) => entry.text.toLowerCase().includes(q));

  if (!matched.length) {
    els.searchResults.innerHTML = '<div class="result-card">No se encontraron coincidencias. Prueba palabras como "offline", "PEI", "docente", "convivencia", "norma" o "informe".</div>';
    return;
  }

  els.searchResults.innerHTML = matched.slice(0, 8).map((item) => `
    <div class="result-card">
      <strong>${item.type}: ${item.title}</strong>
      <p>${item.description}</p>
    </div>
  `).join('');
}

function renderNotes() {
  const els = getViewEls();
  if (!state.notes.length) {
    els.notesList.innerHTML = '<div class="note-item">No hay evidencias guardadas aún. Escribe una nota y guárdala para la escuela.</div>';
    return;
  }

  els.notesList.innerHTML = state.notes.map((note) => `
    <div class="note-item">
      <div class="req-header">
        <strong>${note.title}</strong>
        <span>${note.category}</span>
      </div>
      <small>${new Date(note.createdAt).toLocaleString('es-CO')}</small>
      <p>${note.text}</p>
    </div>
  `).join('');
}

function saveNote() {
  const els = getViewEls();
  const title = (els.noteTitle.value || '').trim();
  const category = els.noteCategory.value || 'General';
  const text = (els.noteInput.value || '').trim();
  if (!title || !text) return;

  const note = {
    id: Date.now(),
    title,
    category,
    text,
    createdAt: new Date().toISOString()
  };

  state.notes.unshift(note);
  localStorage.setItem('rioNotes', JSON.stringify(state.notes));
  els.noteTitle.value = '';
  els.noteInput.value = '';
  renderNotes();
}

function getTemplateById(templateId) {
  return appData.reportTemplates.find((template) => template.id === templateId) || appData.reportTemplates[0];
}

function buildReportFromTemplate(templateId, contextText) {
  const template = getTemplateById(templateId);
  const context = (contextText || '').trim();

  const intro = 'Este documento es una plantilla de apoyo institucional generada localmente y debe ser revisada por el docente o la autoridad responsable antes de usarse como evidencia oficial.\n\n';
  const contextLine = context
    ? `Contexto aportado por el usuario: ${context}\n\n`
    : 'Contexto: no se indicó información adicional. Se recomienda describir el curso, la situación, la fecha y la evidencia antes de usar el informe como documento formal.\n\n';

  const body = template.sections.map((section) => {
    return `${section.title}:\n${section.content}${context ? ` En este caso: ${context}.` : ''}`;
  }).join('\n\n');

  return `${intro}${template.title}\n\n${contextLine}${body}`;
}

function renderReportTemplates() {
  const els = getViewEls();
  els.reportTemplateSelect.innerHTML = appData.reportTemplates
    .map((template) => `<option value="${template.id}">${template.title}</option>`)
    .join('');
  els.reportTemplateSelect.value = state.selectedTemplateId;

  els.reportTemplates.innerHTML = appData.reportTemplates.map((template) => `
    <div class="info-card compact-card">
      <h3>${template.title}</h3>
      <p>${template.purpose}</p>
      <button class="primary-btn small-btn" type="button" data-template="${template.id}">Usar plantilla</button>
    </div>
  `).join('');

  els.reportTemplates.querySelectorAll('[data-template]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.template;
      state.selectedTemplateId = id;
      els.reportTemplateSelect.value = id;
      const context = els.reportContextInput.value.trim();
      if (context) {
        const generated = buildReportFromTemplate(id, context);
        renderGeneratedReports(generated, id);
      }
    });
  });
}

function escapeHtml(value) {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function renderGeneratedReports(reportText, templateId) {
  const els = getViewEls();
  const template = getTemplateById(templateId);
  const report = {
    id: Date.now(),
    templateId,
    title: template.title,
    content: reportText,
    createdAt: new Date().toISOString()
  };

  state.reports.unshift(report);
  localStorage.setItem('rioReports', JSON.stringify(state.reports));

  els.generatedReports.innerHTML = state.reports.map((item) => `
    <div class="report-card">
      <div class="req-header">
        <strong>${item.title}</strong>
        <span>${new Date(item.createdAt).toLocaleString('es-CO')}</span>
      </div>
      <pre>${escapeHtml(item.content)}</pre>
    </div>
  `).join('');

  const totalPending = Math.max(0, state.reports.length - 1);
  els.pendingReports.textContent = String(totalPending);
}

function generateReport() {
  const els = getViewEls();
  const templateId = els.reportTemplateSelect.value || state.selectedTemplateId;
  const context = (els.reportContextInput.value || '').trim();
  const reportText = buildReportFromTemplate(templateId, context);
  renderGeneratedReports(reportText, templateId);
}

function buildAssistantReply(query) {
  const q = query.toLowerCase();

  if (q.includes('pei') || q.includes('proyecto educativo') || q.includes('plan de estudio')) {
    return {
      title: 'PEI y plan de estudio',
      text: 'El PEI debe orientar la misión, la visión y la forma como el colegio materializa la práctica escolar. Para apoyar una decisión, debe relacionarse con competencias, objetivos, evidencias y procedimiento institucional, sin dejar la respuesta como un texto aislado o sin revisión docente.'
    };
  }

  if (q.includes('manual') || q.includes('convivencia') || q.includes('norma') || q.includes('faltas')) {
    return {
      title: 'Convivencia y normas',
      text: 'Para una situación de convivencia, la respuesta debe ser objetiva, pedagógica y documentada. Primero describa hechos, después relacione la situación con la norma o manual institucional y finalmente defina acompañamiento, seguimiento y registro responsable.'
    };
  }

  if (q.includes('offline') || q.includes('sin internet') || q.includes('conexion')) {
    return {
      title: 'Modo offline',
      text: 'El sistema debe funcionar localmente con acceso a la información, registro de notas, búsqueda y respaldos sin depender de internet. Cuando haya conexión, puede sincronizarse de forma segura y mantener auditoría local.'
    };
  }

  if (q.includes('docente') || q.includes('mediacion') || q.includes('evaluacion')) {
    return {
      title: 'Rol del docente',
      text: 'La IA sirve como apoyo para organizar, redactar y sugerir recomendaciones, pero la responsabilidad final del análisis, la evaluación y la decisión pedagógica corresponde al docente o rector.'
    };
  }

  if (q.includes('seguridad') || q.includes('datos') || q.includes('privacidad')) {
    return {
      title: 'Seguridad y protección de datos',
      text: 'El sistema debe aplicar mínimo privilegio, roles y permisos, limitar la recolección de información sensible y conservar trazabilidad de decisiones. La protección de menores exige control de acceso y revisión docente.'
    };
  }

  const hits = appData.requirements.filter((req) => {
    const text = `${req.id} ${req.description}`.toLowerCase();
    return text.includes(q) || q.includes(req.id.toLowerCase());
  }).slice(0, 3);

  if (hits.length) {
    return {
      title: 'Requisitos relevantes',
      text: hits.map((r) => `${r.id}: ${r.description}`).join(' · ')
    };
  }

  return {
    title: 'Respuesta general',
    text: 'RIO-CARIBE propone un enfoque social, técnico y pedagógico para escuelas rurales: trabajo offline, trazabilidad, alineación con el PEI, atención a convivencia, acompañamiento docente y evidencia documental.'
  };
}

function askAssistant() {
  const els = getViewEls();
  const query = (els.assistantInput.value || '').trim();
  if (!query) return;

  const answer = buildAssistantReply(query);
  const card = `
    <div class="assistant-answer">
      <strong>${answer.title}</strong>
      <div>${answer.text}</div>
    </div>
  `;
  els.assistantOutput.innerHTML = card;
  els.assistantInput.value = '';
}

function updateConnectionStatus() {
  const els = getViewEls();
  const isOnline = navigator.onLine;
  const status = document.getElementById('connectionStatus');
  status.classList.toggle('online', isOnline);
  status.classList.toggle('offline', !isOnline);
  els.networkLabel.textContent = isOnline ? 'Conectado' : 'Sin conexión';
  const lastSync = localStorage.getItem('rioLastSync');
  els.lastSyncLabel.textContent = lastSync ? new Date(lastSync).toLocaleString('es-CO') : 'Nunca';
}

function syncPendingData() {
  if (!navigator.onLine) {
    alert('Actualmente estás sin conexión. La sincronización quedará pendiente hasta que el equipo vuelva a conectarse.');
    return;
  }

  const now = new Date().toISOString();
  localStorage.setItem('rioLastSync', now);
  updateConnectionStatus();
  alert('Sincronización completada. La evidencia y los registros quedaron actualizados.');
}

function bindEvents() {
  const els = getViewEls();

  els.navButtons.forEach((btn) => {
    btn.addEventListener('click', () => setView(btn.dataset.view));
  });

  els.filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      state.filter = btn.dataset.filter;
      els.filterButtons.forEach((item) => item.classList.toggle('active', item === btn));
      renderRequirements();
    });
  });

  els.searchInput.addEventListener('input', (event) => {
    renderSearchResults(event.target.value);
  });

  document.getElementById('searchBtn').addEventListener('click', () => {
    renderSearchResults(els.searchInput.value);
  });

  document.getElementById('askAssistantBtn').addEventListener('click', askAssistant);
  els.assistantInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') askAssistant();
  });

  document.getElementById('saveNoteBtn').addEventListener('click', saveNote);
  document.getElementById('syncBtn').addEventListener('click', syncPendingData);

  document.getElementById('generateReportBtn').addEventListener('click', generateReport);
  els.reportTemplateSelect.addEventListener('change', (event) => {
    state.selectedTemplateId = event.target.value;
  });

  document.querySelectorAll('[data-view]').forEach((button) => {
    const target = button.dataset.view;
    if (target && !button.classList.contains('nav-btn') && !button.classList.contains('filter-btn')) {
      button.addEventListener('click', () => setView(target));
    }
  });

  window.addEventListener('online', updateConnectionStatus);
  window.addEventListener('offline', updateConnectionStatus);
}

function initApp() {
  renderDashboardMetrics();
  renderOperationalChecklist();
  renderOverview();
  renderRequirements();
  renderInstitutionalContent();
  renderTraceability();
  renderSearchResults('');
  renderNotes();
  renderReportTemplates();

  if (!state.reports.length) {
    renderGeneratedReports('Este es un informe de ejemplo generado localmente. Revisa antes de usarlo como evidencia institucional.', appData.reportTemplates[0].id);
  } else {
    const container = document.getElementById('generatedReports');
    container.innerHTML = state.reports.map((item) => `
      <div class="report-card">
        <div class="req-header">
          <strong>${item.title}</strong>
          <span>${new Date(item.createdAt).toLocaleString('es-CO')}</span>
        </div>
        <pre>${escapeHtml(item.content)}</pre>
      </div>
    `).join('');
  }

  updateConnectionStatus();
  bindEvents();
}

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./service-worker.js').catch(() => {});
  });
}

initApp();
